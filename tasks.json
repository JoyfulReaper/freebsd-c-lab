{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FreeBSD: Ensure Directory",
            "type": "shell",
            "command": "ssh",
            "args": [
                "freebsd-dev",
                "mkdir -p ~/src/learn-c"
            ],
            "problemMatcher": []
        },
        {
            "label": "FreeBSD: Copy",
            "type": "shell",
            "command": "scp",
            "args": [
                "${file}",
                "freebsd-dev:~/src/learn-c/${fileBasename}"
            ],
            "dependsOn": "FreeBSD: Ensure Directory",
            "problemMatcher": []
        },
        {
            "label": "FreeBSD: Compile",
            "type": "shell",
            "command": "ssh",
            "args": [
                "freebsd-dev",
                "cd ~/src/learn-c && cc -Wall -Wextra -Wpedantic -g -o ${fileBasenameNoExtension} ${fileBasename}"
            ],
            "dependsOn": "FreeBSD: Copy",
            "problemMatcher": []
        },
        {
            "label": "FreeBSD: Run",
            "type": "shell",
            "command": "ssh",
            "args": [
                "freebsd-dev",
                "cd ~/src/learn-c && ./${fileBasenameNoExtension}"
            ],
            "dependsOn": "FreeBSD: Compile",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}